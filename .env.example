# ==============================================================================
# IT HELPDESK SYSTEM — ENVIRONMENT CONFIGURATION
# ==============================================================================

APP_NAME=IT Helpdesk System
APP_ENV=development
DEBUG=true

# Database (PostgreSQL 16 in Docker, or sqlite+aiosqlite for standalone dev)
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_secret_pass
POSTGRES_DB=helpdesk_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://helpdesk:helpdesk_secret_pass@db:5432/helpdesk_db

# Authentication (Corporate LDAP / Active Directory + JWT)
# Set LDAP_ENABLED=true and point to your AD server in production
LDAP_ENABLED=false
LDAP_ALLOW_LOCAL_FALLBACK=true
LDAP_SERVER_URI=ldap://dc.company.local:389
LDAP_USE_SSL=false
LDAP_DOMAIN=COMPANY
LDAP_BASE_DN=DC=company,DC=local
LDAP_USER_DN_TEMPLATE={username}@company.local
LDAP_SEARCH_FILTER=(sAMAccountName={username})
LDAP_BIND_TIMEOUT_SECONDS=5
# Optional AD Group mapping (DN substring or CN)
LDAP_ADMIN_GROUP=Helpdesk_Admins
LDAP_LEAD_GROUP=IT_Leads
LDAP_AGENT_GROUP=IT_Agents

JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production-64chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# MinIO Object Storage
MINIO_ENABLED=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_INTERNAL_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_BUCKET=helpdesk-attachments
MINIO_USE_SSL=false

# Transactional Outbox & n8n Webhook
N8N_WEBHOOK_URL=http://host.docker.internal:5678/webhook/it-helpdesk
N8N_WEBHOOK_SECRET=helpdesk-n8n-secret
N8N_DRY_RUN=true
RUN_EMBEDDED_WORKERS=true
OUTBOX_POLL_INTERVAL_SECONDS=5
SLA_SCAN_INTERVAL_SECONDS=30

# CORS & Frontend
CORS_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
